{
  "name": "bionic-epub-reader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "web": "vite --host 0.0.0.0",
    "build": "vite build",
    "web:build": "vite build",
    "typecheck": "tsc -p tsconfig.web.json --noEmit",
    "web:check": "tsc -p tsconfig.web.json --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "web:preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "epubjs": "0.3.93",
    "lucide-react": "^0.544.0",
    "pdfjs-dist": "^6.4.299",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.2",
    "happy-dom": "^21.0.1",
    "prettier": "2.8.8",
    "typescript": "^6.0.3",
    "vite": "^7.1.5",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "epubjs": {
      "@xmldom/xmldom": "0.9.12"
    }
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
